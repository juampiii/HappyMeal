#!/bin/bash
set -euo pipefail
# An exact grammar, not a shell command. Never eval SSH_ORIGINAL_COMMAND.
if [[ ${SSH_ORIGINAL_COMMAND:-} =~ ^deploy\ ([0-9a-f]{40})\ ([1-9][0-9]{0,8})$ ]]; then
  exec /usr/bin/sudo -n /usr/local/sbin/happymeal-deploy "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
fi
echo 'Only deploy COMMIT_SHA WORKFLOW_RUN_NUMBER is accepted' >&2
exit 2
